<IfModule mod_rewrite.c>
  Options -Multiviews -Indexes
  RewriteEngine On

  # Security: files in the upload folders are never served as code (blocks uploaded scripts)
  RewriteRule ^(uploads|images/uploads)/.*\.(php[0-9]?|phtml|phar|pht|phps|pl|py|cgi|sh|asp|aspx|jsp|shtml|svgz?|html?|js)$ - [F,L,NC]
  # Security: hidden/dot files (.htaccess, .git, .env ...) are never served
  RewriteRule (^|/)\. - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>

# ── Browser Caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Images: cache for 1 month
  ExpiresByType image/jpeg   "access plus 1 month"
  ExpiresByType image/png    "access plus 1 month"
  ExpiresByType image/webp   "access plus 1 month"
  ExpiresByType image/avif   "access plus 1 month"
  ExpiresByType image/gif    "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  # Fonts
  ExpiresByType font/woff2   "access plus 1 year"
  ExpiresByType font/woff    "access plus 1 year"
  # CSS & JS: cache for 1 week (version-busted via ?v= query string)
  ExpiresByType text/css     "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ── Gzip Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE text/xml application/xml application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── Cache-Control headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
# ── Security headers ─────────────────────────────────────────────────────────
# (no visual effect: they only tell browsers to refuse common attacks)
<IfModule mod_headers.c>
  # don't let other sites put these pages in a frame (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # never guess a file's type from its content (stops "image that is really a script")
  Header always set X-Content-Type-Options "nosniff"
  # don't leak full page addresses to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # this site never needs camera / microphone / location / payment
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # safe policy that can't break existing scripts, styles, fonts, images or the map
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  # don't advertise the server software / PHP version
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
